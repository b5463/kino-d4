{
  "name": "@kino/print",
  "private": true,
  "version": "1.0.3",
  "license": "MIT",
  "author": "KINO",
  "description": "KINO Print — local USB print host for Original Prusa i3 MK3S",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5178\" \"wait-on http://127.0.0.1:5178 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5178 electron .\"",
    "build": "tsc --noEmit -p tsconfig.app.json && vite --config vite.config.mjs build",
    "dist:win": "npm run build && node scripts/package-win.mjs",
    "lint": "tsc --noEmit -p tsconfig.app.json",
    "test": "python -m unittest discover -s . -p test_*.py -v"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "38.8.6",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.4"
  }
}
