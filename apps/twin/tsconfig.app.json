{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // simulator-engine consumes kdp/test-fixtures as raw TypeScript sources;
    // compile those packages under the same indexed-access setting their own
    // projects use instead of imposing Twin's stricter app-only setting.
    "noUncheckedIndexedAccess": false,
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src", "tests", "../../packages/kdp/src/types/webserial.d.ts"]
}
