infra/backups/

# host_preview builds a native binary next to its source; the tool is the
# source, not the executable.
firmware/p4/host_preview/preview
firmware/p4/host_preview/preview.exe
firmware/p4/host_preview/*.ppm
# ...and out/, which is the path the documented render command actually writes
# to, so a render left 44 untracked PPMs one `git add -A` from being committed.
firmware/p4/host_preview/out/
# The host-test binaries were enumerated one target at a time, so every suite
# added since left its executable untracked-but-visible and one `git add -A`
# away from being committed. Six were sitting in the tree when this was
# written. A pattern instead: the sources are test_*.c, so ignore the
# extensionless build products and the Windows .exe, and re-include the sources.
firmware/p4/host_tests/test_*
!firmware/p4/host_tests/test_*.c
firmware/components/kdp_core/host_tests/test_*
!firmware/components/kdp_core/host_tests/test_*.c
firmware/*/build-*/
