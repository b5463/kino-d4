# The relay VPS, not the PC. Copy to infra/relay/vps/.env on the VPS and never
# commit that file.
#
#   cp .env.example .env && docker compose up -d
#
# Two values, and both must match something else:
#
# KINO_SITE_ADDRESS is the public hostname Caddy obtains a certificate for over
# ACME. It must be the name the Websupport A record points at this machine, and
# it must equal KINO_SITE_ADDRESS/PUBLIC_BASE_URL in the PC's
# infra/.env.production. A mismatch means Caddy asks Let's Encrypt for a name
# that does not resolve here and the certificate never issues.
KINO_SITE_ADDRESS=kino.acronym.sk

# RELAY_TOKEN is the frp shared secret. It must be byte-identical to RELAY_TOKEN
# in the PC's infra/.env.production. Generate it once, on either machine:
#
#   openssl rand -hex 32
#
# frps refuses a client that presents a different token, and frpc's log then
# says `login to server failed: authorization failed` rather than anything about
# the token. This is the single most common relay bring-up failure.
RELAY_TOKEN=change-me-long-frp-shared-token
