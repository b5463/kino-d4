# kino.acronym.sk on the relay VPS. Caddy obtains and renews the certificate
# itself (ACME over 80/443) and forwards everything to the tunnelled PC Caddy
# on 127.0.0.1:8080, which routes /api/* and / exactly as production does.
# flush_interval -1: the Roll feed is server-sent events.
{$KINO_SITE_ADDRESS} {
	encode zstd gzip {
		# An explicit allow list instead of Caddy's default, whose `text/*` entry
		# includes `text/event-stream`. The Roll feed is SSE
		# (GET /api/rolls/:slug/events, /api/host/rolls/:id/events) and a
		# compressor in front of a long-lived stream is the classic way an event
		# arrives in a batch minutes late. `flush_interval -1` on the proxy is
		# only half the answer; this is the other half. Fonts (woff2) and
		# photographs (JPEG/MP4) are already compressed and are left alone.
		match {
			header Content-Type text/html*
			header Content-Type text/plain*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type application/manifest+json*
			header Content-Type image/svg+xml*
		}
	}
	reverse_proxy 127.0.0.1:8080 {
		flush_interval -1
		header_up X-Forwarded-Proto https
	}
	log
}
