# Copy to infra/.env.production, replace every change-me value, and never commit that file.
KINO_ENV=production
KINO_SITE_ADDRESS=kino.acronym.sk
PUBLIC_BASE_URL=https://kino.acronym.sk
KINO_HTTP_PORT=80
KINO_HTTPS_PORT=443
LOG_LEVEL=info

# NODE_ENV is pinned to `production` by docker-compose.prod.yml and is listed
# here only so the fact is written down. Leaving it unset fails CLOSED — the
# published dev COOKIE_SECRET and PROVISIONING_TOKEN are refused, CORS stops
# reflecting localhost — which is the behaviour you want if you ever run the
# API outside Compose.
#NODE_ENV=production
# The API listens on 3000 inside its container and the Caddyfiles proxy to
# api:3000. Change both or neither.
#PORT=3000

POSTGRES_DB=kino
POSTGRES_USER=kino
POSTGRES_PASSWORD=change-me-long-postgres-secret
DATABASE_URL=postgres://kino:change-me-long-postgres-secret@postgres:5432/kino

REDIS_PASSWORD=change-me-long-redis-secret
REDIS_URL=redis://:change-me-long-redis-secret@redis:6379
JOB_QUEUE_PREFIX=kino-jobs
METRICS_TOKEN=change-me-long-prometheus-bearer-token

S3_ACCESS_KEY=change-me-minio-access-key
S3_SECRET_KEY=change-me-long-minio-secret
S3_BUCKET=kino-media
S3_FIRMWARE_BUCKET=kino-firmware
S3_REGION=us-east-1

COOKIE_SECRET=change-me-at-least-32-random-characters
# Studio presents this once to register a camera (roll-provisioning model, #146). Compose refuses to start without it.
PROVISIONING_TOKEN=change-me-long-provisioning-token

# Which hop is allowed to name the client address.
#
# NOT a boolean any more, and `true` is refused: trusting every hop means
# whatever a client puts in X-Forwarded-For becomes request.ip, and every
# per-address rate limit, the guest slug-miss lock and the audit log then key on
# a value the attacker chose.
#
# The list form below is right for both deployment shapes. Direct production is
# client -> Caddy -> api; the relay adds VPS Caddy and frp in front, so the
# number of hops that append to the header differs between the two compose
# files. proxy-addr walks the header right to left, discards every entry inside
# the private/loopback space, and stops at the first public address — the guest.
# A forged prefix sits to the left of the real one and is never reached.
#
# A hop count (TRUST_PROXY=1) is also accepted, for a deployment that knows
# exactly how many proxies it has.
TRUST_PROXY=loopback,uniquelocal

# ---------------------------------------------------------------- relay ----
# PC-hosted production reached through a relay VPS: no port forwarding, works
# behind carrier NAT, DNS stays at Websupport (infra/relay/). Both are required
# by infra/relay/docker-compose.relay.yml and it refuses to start without them.
#
#   docker compose --env-file infra/.env.production \
#     -f infra/docker-compose.prod.yml -f infra/relay/docker-compose.relay.yml up -d --build
#
# RELAY_HOST is the VPS's address (the same machine kino.acronym.sk resolves to).
# RELAY_TOKEN is the frp shared secret and must match RELAY_TOKEN in the VPS's
# own infra/relay/vps/.env. Generate it once: openssl rand -hex 32
RELAY_HOST=change-me-relay-vps-address
RELAY_TOKEN=change-me-long-frp-shared-token

# PC-hosted production behind an outbound Cloudflare Tunnel (infra/docker-compose.tunnel.yml).
# The token comes from the Zero Trust dashboard for the tunnel whose public hostname is
# kino.acronym.sk -> http://proxy:80. Leave unset when the proxy publishes 80/443 itself.
#CLOUDFLARE_TUNNEL_TOKEN=change-me-cloudflare-tunnel-token

# ------------------------------------------------------------------- AI ----
# Read by the worker (apps/worker/src/ai/provider.ts). Every value defaults
# closed, so leaving this whole block commented out is a valid production
# configuration and is the shipped one: no enhancement runs and no frame goes
# anywhere.
#
# AI_MODE          off | subtle | custom       (off wins over everything)
# AI_PROVIDER      local | self-hosted | external
# AI_ENDPOINT      required for a non-local provider
# AI_MODEL         required for a non-local provider; recorded as provenance
# AI_ALLOW_EXTERNAL  must be exactly `true` before a frame may leave the
#                    platform. An external provider without it is refused
#                    before any code reaches for the network.
# AI_OPERATIONS    CUSTOM only: comma-separated wiggle-safe operations
# AI_STRENGTH      CUSTOM only: 0..1
#AI_MODE=off
#AI_PROVIDER=
#AI_ENDPOINT=
#AI_MODEL=
#AI_ALLOW_EXTERNAL=false
#AI_OPERATIONS=
#AI_STRENGTH=

# ffmpeg for the MP4 renders. Unset uses the bundled ffmpeg-static, which is
# what the worker image ships; set it only to point at a system build.
#FFMPEG_PATH=
