# Staging must use distinct credentials, database, buckets, volumes, and public hostname.
KINO_ENV=staging
KINO_SITE_ADDRESS=staging.kino.acronym.sk
PUBLIC_BASE_URL=https://staging.kino.acronym.sk
KINO_HTTP_PORT=8080
KINO_HTTPS_PORT=8443
LOG_LEVEL=debug

POSTGRES_DB=kino_staging
POSTGRES_USER=kino_staging
POSTGRES_PASSWORD=change-me-distinct-staging-postgres-secret
DATABASE_URL=postgres://kino_staging:change-me-distinct-staging-postgres-secret@postgres:5432/kino_staging

REDIS_PASSWORD=change-me-distinct-staging-redis-secret
REDIS_URL=redis://:change-me-distinct-staging-redis-secret@redis:6379
JOB_QUEUE_PREFIX=kino-jobs
METRICS_TOKEN=change-me-distinct-staging-prometheus-token

S3_ACCESS_KEY=change-me-staging-minio-access-key
S3_SECRET_KEY=change-me-distinct-staging-minio-secret
S3_BUCKET=kino-staging-media
S3_FIRMWARE_BUCKET=kino-staging-firmware
S3_REGION=us-east-1

COOKIE_SECRET=change-me-distinct-staging-cookie-secret
# Studio presents this once to register a camera (roll-provisioning model, #146).
# docker-compose.prod.yml guards it with `:?`, so an environment file without it
# fails at config time and the stack never starts.
PROVISIONING_TOKEN=change-me-distinct-staging-provisioning-token

# Which hop may name the client address. Not a boolean — `true` is refused.
# Same value as production: the default names the private ranges Caddy and frp
# live in. See infra/.env.prod.example for the full note.
TRUST_PROXY=loopback,uniquelocal

# Eleven variables in this file are guarded with `:?` in
# infra/docker-compose.prod.yml and have no default: KINO_SITE_ADDRESS,
# PUBLIC_BASE_URL, POSTGRES_PASSWORD, DATABASE_URL, REDIS_PASSWORD, REDIS_URL,
# METRICS_TOKEN, S3_ACCESS_KEY, S3_SECRET_KEY, COOKIE_SECRET and
# PROVISIONING_TOKEN. Everything else above has a compose default and is set
# here only to keep staging off production's names.
