# KINO API — environment template.
#
# Copy this file to `infra/.env` (gitignored) and edit. The test suite loads it
# through `apps/api/tests/setup-env.ts`; an inline variable on the command line
# beats the file. Every value below is ALSO the built-in fallback in
# `apps/api/src/config.ts`, so a plain
# `docker compose -f infra/docker-compose.dev.yml up -d` +
# `npm run test -w @kino/api` works with no .env file at all.
#
# These are DISPOSABLE LOCAL DEV CREDENTIALS matching infra/docker-compose.dev.yml.
# Never put a real secret in this file — it is committed.

# Postgres. Host port is 5435, not 5432: the dev host runs native PostgreSQL
# clusters on 5432 and 5433, and 5434 belongs to another project. The
# container-internal port is still the standard 5432.
DATABASE_URL=postgres://kino:kino@localhost:5435/kino

# Redis. Host port is 6380, not 6379: another project owns a 6379 mapping, and
# claiming it would stop their container binding on restart.
REDIS_URL=redis://localhost:6380

# MinIO (S3-compatible). Console is on http://localhost:9001.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=kino-media
S3_FIRMWARE_BUCKET=kino-firmware
S3_ACCESS_KEY=kino
S3_SECRET_KEY=kino-secret
S3_REGION=us-east-1

PUBLIC_BASE_URL=https://kino.acronym.sk

# Signs the guest PIN session cookie. The value below is the same published dev
# default that `apps/api/src/config.ts` falls back to — it is NOT a secret, and
# config loading FAILS if it is still in place unless NODE_ENV says development
# or test. Generate a real one for any deployment: `openssl rand -base64 48`.
COOKIE_SECRET=kino-dev-cookie-secret-do-not-use-in-production

# NODE_ENV has NO default and is deliberately not set here.
#
# The cookie-secret check above asks "is this provably development?", not "is
# this production?", so leaving it unset fails CLOSED. Vitest sets `test` for
# the test run, which is why `npm run test -w @kino/api` works untouched.
#
# `npm run dev -w @kino/api` runs src/dev.ts, which loads this file and sets
# NODE_ENV=development when unset. `src/main.ts` (production) reads only real
# environment variables — leaving NODE_ENV unset there still fails CLOSED.
# NODE_ENV=development
#
# Local guest/host links and QRs need the roll-web dev server, not production:
# PUBLIC_BASE_URL=http://localhost:5173   # or http://<lan-ip>:5173 for phones

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
