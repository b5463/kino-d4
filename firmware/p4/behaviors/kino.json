{
  "_": "How KINO moves. Clips are choreography over roles; events map to variants with weights, rules and conditions. ui.c binds roles to scene nodes and reports events; nothing here knows about the camera, and nothing in the camera knows about these.",

  "curves": {
    "snap":    { "bezier": [0.12, 0.9, 0.22, 1.0] },
    "settle":  { "bezier": [0.3, 0.0, 0.1, 1.0] },
    "leave":   { "bezier": [0.6, 0.0, 0.9, 0.3] },
    "hard":    { "bezier": [0.9, 0.0, 1.0, 0.1] },
    "late":    { "samples": [0, 0.02, 0.05, 0.1, 0.2, 0.55, 0.85, 0.96, 1.0] }
  },

  "paths": {
    "label_in": { "quad": [[220, 90], [90, -30], [0, 0]] },
    "frag_nw":  { "quad": [[-200, -120], [-140, -30], [0, 0]] },
    "frag_ne":  { "quad": [[200, -120], [110, -50], [0, 0]] },
    "frag_sw":  { "quad": [[-200, 120], [-90, 60], [0, 0]] },
    "frag_se":  { "quad": [[200, 120], [160, 30], [0, 0]] }
  },

