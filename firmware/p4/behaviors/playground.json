{
  "_": "The engine's test surface, not the product. Every capability the runtime claims has a clip here that the host preview films (preview --playground) and the Twin's PLAYGROUND button run. Nothing in this file is reachable from the shipping interface.",

  "curves": {
    "pg_snap": { "bezier": [0.1, 0.9, 0.2, 1.0] },
    "pg_rush": { "bezier": [0.7, 0.0, 0.9, 0.2] },
    "pg_stall": { "samples": [0, 0.35, 0.5, 0.52, 0.53, 0.55, 0.6, 0.85, 1.0] },
    "pg_pow3": { "pow": 3 }
  },

  "paths": {
    "pg_arc": { "quad": [[-260, 120], [-60, -140], [0, 0], [40, 90], [220, -20]] },
    "pg_zig": { "poly": [[-200, 0], [-120, -60], [-40, 40], [40, -20], [120, 60], [200, 0]] }
  },

  "clips": {
    "pg_keys": {
      "_": "One channel, six keys, a different interpolation per segment: the word does not move smoothly and that is the test.",
      "tracks": {
        "a.x": [[0, -80, "lin"], [180, 12, "hold"], [340, -5, "step:3"], [570, 2, "smooth"], [710, 0, "spring", 5, 0.3], [1000, 0]],
        "a.alpha": [[0, 0, "pg_snap"], [70, 255]]
      }
    },
    "pg_curves": {
      "_": "Five objects, the same distance, five curves. Read the spacing.",
      "tracks": {
        "a.x": [[0, -200, "lin"], [600, 200]],
        "b.x": [[0, -200, "pg_snap"], [600, 200]],
        "c.x": [[0, -200, "pg_rush"], [600, 200]],
        "d.x": [[0, -200, "pg_stall"], [600, 200]],
        "e.x": [[0, -200, "pg_pow3"], [600, 200]]
      }
    },
    "pg_spring": {
      "_": "Underdamped spring and exponential smoothing side by side, toward the same target.",
      "tracks": {
        "a.x": [[0, -160, "spring", 3.5, 0.18], [1400, 0]],
        "b.x": [[0, -160, "exp", 110], [1400, 0]],
        "c.x": [[0, -160, "spring", 6, 0.55], [1400, 0]]
      }
    },
    "pg_path": {
      "_": "Along a quadratic path, orientation on the tangent; a second object on a polyline, upright.",
      "tracks": {
        "a@pg_arc~": [[0, 0, "pg_snap"], [900, 1]],
        "b@pg_zig": [[0, 0, "lin"], [900, 1]]
      }
    },
    "pg_parent": {
      "_": "The parent lands; the child inherits the transform through the graph, follows late through a modifier, and turns on its own.",
      "tracks": {
        "a.y": [[0, -140, "spring", 4, 0.35], [900, 0]],
        "a.rot": [[0, -6, "spring", 3.5, 0.3], [900, 0]],
        "b.rot": [[120, 0, "spring", 5, 0.2], [180, 14, "spring", 4, 0.25], [900, 0]]
      },
      "mods": [{ "role": "b", "follow": { "target": "a", "lag": 70 } }]
    },
    "pg_mask": {
      "_": "A word revealed by a mask edge moving across it; an image assembled from strips that slide in from different sides.",
      "tracks": {
        "a.mx1": [[0, 0, "pg_snap"], [420, 600]],
        "a.my1": [[0, 60, "hold"], [420, 60]],
        "s0.x+": [[0, -420, "pg_snap"], [260, 0]],
        "s1.x+": [[0, 380, "pg_snap"], [320, 0]],
        "s2.x+": [[0, -300, "pg_snap"], [380, 0]],
        "s3.x+": [[0, 460, "pg_snap"], [440, 0]],
        "s0.alpha": [[0, 0, "hold"], [30, 255]],
        "s1.alpha": [[0, 0, "hold"], [60, 255]],
        "s2.alpha": [[0, 0, "hold"], [90, 255]],
        "s3.alpha": [[0, 0, "hold"], [120, 255]]
      }
    },
    "pg_char": {
      "_": "Per-glyph: each character enters from below with a little overshoot and a tilt that settles. Applied with a stagger.",
      "tracks": {
        "char.y": [[0, 26, "spring", 4.5, 0.3], [500, 0]],
        "char.rot": [[0, -12, "spring", 3.5, 0.25], [500, 0]],
        "char.alpha": [[0, 0, "pg_snap"], [80, 255]],
        "char.sx": [[0, 0.7, "spring", 5, 0.35], [400, 1]],
        "char.sy": [[0, 1.3, "spring", 5, 0.35], [400, 1]]
      }
    },
    "pg_tracking": {
      "_": "Tracking as animation: the word opens on impact and closes with one glyph of lag left in the char clip.",
      "tracks": {
        "a.track": [[0, 0, "hold"], [60, 18, "spring", 4, 0.4], [600, 0]],
        "a.sx": [[0, 1, "hold"], [60, 1.18, "spring", 6, 0.5], [500, 1]],
        "a.sy": [[0, 1, "hold"], [60, 0.86, "spring", 6, 0.5], [500, 1]]
      }
    },
    "pg_deform": {
      "_": "Squash and stretch, skew, and strip deformation on a picture, one after another.",
      "tracks": {
        "img.sy": [[0, 1, "hold"], [40, 0.78, "spring", 5, 0.32], [700, 1]],
        "img.sx": [[0, 1, "hold"], [40, 1.14, "spring", 5, 0.32], [700, 1]],
        "img.skew": [[600, 0, "hold"], [640, 16, "spring", 4, 0.3], [1300, 0]],
        "img.strip_amp": [[1200, 0, "hold"], [1240, 22, "exp", 180], [2000, 0]],
        "img.strip_freq": [[0, 0.09]],
        "img.strip_ph": [[1200, 0, "lin"], [2000, 9]]
      }
    },
    "pg_rgb": {
      "_": "Colour separation that settles: the channels arrive at different times.",
      "tracks": {
        "img.rgb": [[0, 14, "exp", 140], [700, 0]],
        "a.rgb": [[0, 9, "exp", 160], [700, 0]]
      }
    },
    "pg_noise": {
      "_": "Deterministic low-amplitude noise on position and rotation, windowed, fading in and out.",
      "dur": 1400,
      "tracks": { "a.alpha": [[0, 255]] },
      "mods": [{ "role": "a", "noise": { "amp": [2.5, 1.5, 1.2, 0.02], "hz": 7 }, "from": 100, "to": 1200 }]
    },
    "pg_boil": {
      "_": "Line boil: the drawn line wanders, the object does not.",
      "dur": 1600,
      "tracks": { "l.alpha": [[0, 255]] },
      "mods": [{ "role": "l", "boil": { "amp": [1.6, 1.6, 0.6], "hz": 9 } }]
    },
    "pg_osc": {
      "_": "A damped oscillation added to whatever else the object is doing.",
      "dur": 1200,
      "tracks": { "a.x": [[0, -120, "pg_snap"], [300, 0]] },
      "mods": [{ "role": "a", "osc": { "ch": "rot", "amp": 9, "hz": 3.2, "zeta": 0.16 }, "from": 300 }]
    },
    "pg_warp": {
      "_": "The same motion as pg_curves 'a', with the clip's clock rushed, stalled and released.",
      "warp": "pg_stall",
      "tracks": {
        "a.x": [[0, -200, "lin"], [900, 200]]
      }
    },
    "pg_sound": {
      "_": "Sound markers on frames: the marks converge and the sync cue lands on the frame they meet.",
      "tracks": {
        "m0.x": [[0, -54, "pg_snap"], [260, 0]],
        "m1.x": [[0, -18, "pg_snap"], [260, 0]],
        "m2.x": [[0, 18, "pg_snap"], [260, 0]],
        "m3.x": [[0, 54, "pg_snap"], [260, 0]],
        "m0.r": [[240, 6, "spring", 6, 0.4], [260, 10], [600, 7]]
      },
      "sounds": [{ "t": 260, "cue": "sync" }]
    },
    "pg_move_a": {
      "_": "For the interruption test: a long move to the right...",
      "tracks": { "a.x": [[0, -200, "pg_snap"], [900, 200]], "a.rot": [[0, 0, "lin"], [900, 30]] }
    },
    "pg_move_b": {
      "_": "...interrupted by a move back to the left, which must begin from wherever 'a' is and at the speed it has.",
      "tracks": { "a.x": [[0, 200, "pg_snap"], [700, -200]], "a.rot": [[0, 30, "lin"], [700, -10]] }
    }
  }
}
